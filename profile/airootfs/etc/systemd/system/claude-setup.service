[Unit]
Description=Claude Code Setup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'if command -v claude &>/dev/null; then echo "Claude Code is ready."; else echo "Installing Claude Code..."; npm install -g @anthropic-ai/claude-code && echo "Claude Code installed successfully." || echo "Failed to install Claude Code. Check network connection."; fi'

[Install]
WantedBy=multi-user.target
